{
  "id": null,
  "uid": "open-meteo-forecast",
  "title": "Forecast proxy",
  "description": "Request, cache, and upstream metrics. Counters appear after the corresponding events; rates need at least two scrapes. Cache hit ratio excludes lookup errors.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "open-meteo"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "open-meteo-prometheus"
        },
        "query": "label_values(up{job=\"open-meteo\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Forecast requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_latency_count{job=\"open-meteo\",instance=~\"$instance\",path=\"/forecast\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP responses and cancellations / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_request_latency_count{job=\"open-meteo\",instance=~\"$instance\",path=\"/forecast\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Forecast p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_latency_bucket{job=\"open-meteo\",instance=~\"$instance\",path=\"/forecast\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(forecast_cache_operations_total{job=\"open-meteo\",instance=~\"$instance\",operation=\"get\",outcome=\"hit\"}[$__rate_interval])) or vector(0)) / sum(rate(forecast_cache_operations_total{job=\"open-meteo\",instance=~\"$instance\",operation=\"get\",outcome=~\"hit|miss\"}[$__rate_interval]))",
          "legendFormat": "Hit ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(forecast_cache_operations_total{job=\"open-meteo\",instance=~\"$instance\",outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Upstream attempts / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, status) (rate(forecast_upstream_attempts_total{job=\"open-meteo\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}} / {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Upstream retries / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(forecast_upstream_retries_total{job=\"open-meteo\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Active upstream fetches",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "forecast_active_fetches{job=\"open-meteo\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Concurrency rejections / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(forecast_rejected_requests_total{job=\"open-meteo\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Rejected",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Scrape target availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "open-meteo-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"open-meteo\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "open-meteo-prometheus"
          }
        }
      ]
    }
  ]
}
